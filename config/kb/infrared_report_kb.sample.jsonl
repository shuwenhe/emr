{"id":"KB-IR-SOP-0001","title":"热成像检查前静息要求","content":"红外热成像检查前宜静息15至20分钟，避免剧烈运动、热水浴、饮酒及外用刺激性药物，以减少短时体表温度波动对判读的干扰。","category":"sop_preparation","report_sections":["report_note"],"tags":["检查准备","静息","环境控制"],"source":"院内热成像检查SOP v1.0","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["门诊常规热成像采集"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":[],"evidence_level":"internal_sop","retrieval_hints":["检查前准备","静息20分钟","避免热刺激"]}
{"id":"KB-IR-INT-0001","title":"左右对称差异优先于绝对温度","content":"体表温度判读应优先关注左右对称区域的相对温差、局部热点或冷点分布及动态变化，不宜仅依据单次绝对温度值直接下结论。","category":"interpretation_symmetry","report_sections":["diagnosis","doctor_opinion"],"tags":["对称性","温差","判读原则"],"source":"热成像判读规范（试行）","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["左右对称ROI可比较","采集姿势一致"],"contraindications":["环境温度波动明显时慎用单次结论"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["左右温差","ROI对称","相对温度"],"structured_advice":{"interpretation_focus":"symmetry_before_absolute_temperature"}}
{"id":"KB-IR-INT-0002","title":"局部高温区提示炎症或应激风险","content":"若局部区域温度明显高于周围组织或对侧对应区域，可提示炎症反应、应激负荷增加或局部循环活跃，应结合主诉、触诊及必要的实验室或影像检查综合评估。","category":"interpretation_hotspot","report_sections":["diagnosis","doctor_opinion"],"tags":["热点","高温","炎症风险"],"source":"区域温度异常判读共识（摘要）","source_type":"consensus","priority":8,"status":"active","applicable_conditions":["存在局部热点","图像质量可判读"],"contraindications":["近期外部热刺激未排除时慎解释"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","膝关节"],"risk_levels":["medium","high"],"evidence_level":"consensus","retrieval_hints":["局部热点","温度升高","炎症可能"]}
{"id":"KB-IR-RISK-0001","title":"报告结论按风险等级表达","content":"热成像报告结论宜按低、中、高风险分层表达。低风险强调生活方式调整与观察，中风险强调短期复评及针对性干预，高风险应明确建议进一步检查或及时专科就诊。","category":"risk_stratification","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["风险分层","报告结论","措辞规范"],"source":"红外热成像评估报告模板说明","source_type":"guideline","priority":9,"status":"active","applicable_conditions":["生成最终报告结论"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["低中高风险","风险分层","结论表达"],"structured_advice":{"output_style":"risk_layered"}}
{"id":"KB-IR-TX-0001","title":"中等风险病例建议短期复评","content":"对于中等风险热成像异常，治疗建议宜包含减轻局部负荷、针对异常区域的理疗或灸疗评估，并建议于7至14天内复测热成像，比较ROI温差及异常区域范围变化。","category":"follow_up_rule","report_sections":["treatment_plan_text","doctor_opinion"],"tags":["复评","中风险","治疗建议"],"source":"门诊随访流程规范","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["风险等级为medium"],"contraindications":["出现红旗症状时不应仅安排常规复评"],"patient_scope":["adult"],"body_parts":["颈肩","腰背"],"risk_levels":["medium"],"evidence_level":"internal_sop","retrieval_hints":["7到14天复评","中风险复查","趋势比较"],"structured_advice":{"follow_up_days_min":7,"follow_up_days_max":14,"action":"复测热成像并比较ROI变化"}}
{"id":"KB-IR-SAFE-0001","title":"存在红旗情况时优先转诊评估","content":"若患者存在发热、急性外伤、活动性出血、严重感染、持续剧烈疼痛、神经功能异常或肿瘤治疗期等情况，报告应提示谨慎解释热成像结果，并优先建议专科评估或转诊。","category":"contraindication","report_sections":["doctor_opinion","treatment_plan_text","report_note"],"tags":["禁忌","转诊","安全边界"],"source":"临床安全边界清单 v2","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["存在红旗症状或特殊病情"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["high"],"evidence_level":"guideline","retrieval_hints":["转诊提醒","红旗症状","谨慎干预"],"structured_advice":{"action":"refer_specialist","urgency":"high"}}
{"id":"KB-IR-SOP-0002","title":"黑体校准可提高温度测量准确性","content":"为保证温度测量的准确性，仪器可配合黑体进行校准。打开黑体并预热20分钟后，将红外摄像头对准黑体，点击“修改区域”，待光标在摄图区域变为十字后，将其移动至参考黑体热图中心，单击鼠标左键即可完成校准。每次开机后，以及对温度精度要求较高时，均可进行黑体校准。","category":"sop_preparation","report_sections":["report_note","health_advice","doctor_opinion"],"tags":["黑体校准","温度测量","精度","预热20分钟","修改区域","红外摄像头"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外设备开机后","对温度精度要求较高时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["黑体校准","预热20分钟","点击修改区域","参考黑体热图中心","提高温度测量准确性"]}
{"id":"KB-IR-SOP-0003","title":"上半身正侧位标准图可作为采集参考","content":"上半身热成像采集时，宜参照上半身正位图和侧位图的标准体位进行拍摄，以保证受检者姿势一致、解剖区域暴露充分、左右对称区域可比，从而减少因体位偏差带来的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","胸腹部","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身正侧位标准图","正位图","侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0004","title":"上半身背侧位标准图可作为采集参考","content":"上半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证背部、肩胛区及脊柱旁区域显示完整，减少因身体旋转、遮挡或姿势不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","背侧位","标准图","采集参考","体位要求","背部热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身背侧位标准图","背侧位","标准体位","背部采集参考","减少判读偏差"]}
{"id":"KB-IR-SOP-0005","title":"下半身正侧位标准图可作为采集参考","content":"下半身热成像采集时，宜参照下半身正位图和侧位图的标准体位进行拍摄，以保证骨盆、髋部、下肢等解剖区域显示完整，左右对应区域具备可比性，从而减少因站姿偏斜、遮挡或体位不一致造成的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","髋部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身正侧位标准图","下半身正位图","下半身侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0006","title":"下半身背侧位标准图可作为采集参考","content":"下半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证臀部、大腿后侧、小腿后侧等区域显示完整，减少因身体旋转、遮挡或站姿不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","背侧位","标准图","采集参考","体位要求","后侧热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","臀部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身背侧位标准图","背侧位","后侧采集参考","标准体位","减少判读偏差"]}
{"id":"KB-IR-SOP-0007","title":"膝关节正侧位标准图可作为采集参考","content":"膝关节热成像采集时，宜参照膝关节正位图和侧位图的标准体位进行拍摄，以保证膝前区、膝外侧及周围软组织区域显示清晰，便于比较双侧膝关节温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["膝关节","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["膝关节热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["膝关节正侧位","膝关节正位图","膝关节侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0008","title":"膝关节背侧位标准图可作为采集参考","content":"膝关节背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证腘窝区、膝后侧及周围软组织区域显示清晰，便于观察后侧温度分布及局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["膝关节","背侧位","标准图","采集参考","体位要求","腘窝区"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["膝关节背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["膝关节背侧位","膝后侧","腘窝区","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0009","title":"足踝部正侧位标准图可作为采集参考","content":"足踝部热成像采集时，宜参照足踝部正位图和侧位图的标准体位进行拍摄，以保证踝关节、足背、足底及周围软组织区域显示清晰，便于比较双侧温度分布和识别局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["足踝部","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["足踝部热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["踝关节","足部","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["足踝部正侧位","足踝部正位图","足踝部侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0010","title":"足踝部背侧位标准图可作为采集参考","content":"足踝部背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证跟腱区、足跟、踝后侧及周围软组织区域显示清晰，便于观察后侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["足踝部","背侧位","标准图","采集参考","体位要求","跟腱区"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["足踝部背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["踝关节","足部","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["足踝部背侧位","踝后侧","跟腱区","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0011","title":"手肘部背侧位标准图可作为采集参考","content":"手肘部背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证肘后区、鹰嘴周围及邻近软组织区域显示清晰，便于观察后侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["手肘部","背侧位","标准图","采集参考","体位要求","鹰嘴"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["手肘部背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","肘关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["手肘部背侧位","肘后区","鹰嘴","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0012","title":"手肘部桡侧位标准图可作为采集参考","content":"手肘部桡侧位热成像采集时，宜参照桡侧位标准图进行体位摆放和图像采集，以保证肘外侧、桡骨头周围及邻近软组织区域显示清晰，便于观察桡侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["手肘部","桡侧位","标准图","采集参考","体位要求","桡骨头"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["手肘部桡侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","肘关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["手肘部桡侧位","肘外侧","桡骨头","标准体位","采集参考"]}
{"id":"KB-IR-INT-0003","title":"热图判读应结合主诉与查体综合分析","content":"在了解生理热图与干扰热图特征后，应结合患者主诉及查体体征进行综合分析。排除生理性改变和干扰热像后，再进行疾病诊断，并结合临床情况给予对症治疗。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","treatment_plan_text"],"tags":["生理热图","干扰热图","主诉","查体体征","综合分析","对症治疗"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["热图判读与临床分析时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["结合主诉和查体综合分析","排除生理与干扰热像","再进行疾病诊断","对症治疗"]}
{"id":"KB-IR-DX-0001","title":"脊柱关节病相关检查诊断设备可用于综合评估","content":"脊柱关节病的检查与诊断宜结合多种设备和方法进行综合评估，可包括红外热成像、X线、CT、MRI及实验室检查等。实际应用中应结合患者主诉、体征及病程特点，选择合适的检查设备和诊断路径。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱关节病","检查设备","诊断设备","综合评估","红外热成像","影像检查"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊柱关节病相关评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱关节病相关检查诊断设备","红外热成像和X线CTMRI","综合评估","诊断路径"]}
{"id":"KB-IR-DX-0002","title":"X线检查对脊柱和关节骨结构病变诊断具有重要作用","content":"骨组织属于人体硬组织，含钙量较多、密度较高，X线不易穿透。由于脊柱和关节病变常可反映为骨结构改变，因此X线检查在相关疾病诊断中具有重要作用。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["骨组织","X线检查","脊柱","关节","骨结构改变","影像诊断"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊柱和关节影像评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","膝关节","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["骨组织含钙量多密度高","X线不易穿透","骨结构改变","X线检查对诊断重要"]}
{"id":"KB-IR-DX-0003","title":"X线检查可为诊断治疗及疗效判断提供依据","content":"通过X线检查，不但可以了解骨与关节损伤或病变的部位、范围、性质、程度以及软组织情况，为疾病诊断和鉴别诊断提供依据，也可为治疗方案制定提供参考。在治疗过程中，还可用于判断骨折脱位的整复、牵引及固定等治疗效果，并观察病变发展和预后情况。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note","treatment_plan_text"],"tags":["X线检查","诊断依据","鉴别诊断","治疗依据","疗效判断","预后评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["骨与关节影像评估及治疗随访时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","膝关节","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["X线检查可了解部位范围性质程度","为诊断和鉴别诊断提供依据","判断骨折脱位整复牵引固定效果","观察病变发展和预后"]}
{"id":"KB-IR-DX-0004","title":"脊柱X线检查主要包括平片检查和脊髓造影","content":"脊柱X线检查的常用方式主要包括平片检查和脊髓造影。临床上可根据病变部位、症状特点及诊断需要，选择适当的检查方式，以辅助判断脊柱结构及相关病变情况。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱X线检查","平片检查","脊髓造影","检查方式","脊柱病变","影像学"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱影像学检查时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱X线检查主要有平片检查和脊髓造影","平片检查","脊髓造影","脊柱影像检查方式"]}
{"id":"KB-IR-DX-0005","title":"脊柱平片常规摄片可包括正位侧位和斜位","content":"脊柱平片检查的常规摄片体位一般包括正位、侧位和左右斜位。根据病情需要，还可加拍张口位、过屈位、过伸位等功能位以及体层摄影片，以提高对特定病变的显示和判断能力。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱平片","正位","侧位","左右斜位","张口位","功能位"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱平片检查时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱平片检查常规摄片","正位侧位左右斜位","张口位","过屈过伸功能位","体层摄影片"]}
{"id":"KB-IR-DX-0006","title":"脊柱正位片可观察椎体序列与椎弓根等结构变化","content":"脊柱正位片主要用于观察脊柱有无侧弯，椎体结构及排列序列是否正常，以及椎间隙、椎弓根的形态、位置和间距变化。同时还可观察横突及椎旁软组织的异常改变，为脊柱病变判断提供依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱正位片","侧弯","椎体序列","椎间隙","椎弓根","椎旁软组织"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱正位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["正位片主要观察什么","脊柱有无侧弯","椎体结构及序列","椎弓根形态位置间距","椎旁软组织变化"]}
{"id":"KB-IR-DX-0007","title":"脊柱侧位片和斜位片可观察椎间孔及关节排列变化","content":"脊柱侧位片可用于观察脊柱生理弯曲、椎体结构及排列序列、椎间隙以及关节突关节的排列情况，尤其有助于判断腰段椎间孔的大小和形态、椎管前后径及寰枕关节情况。左右斜位片则主要用于观察颈椎间孔大小及其周围骨质结构变化。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱侧位片","斜位片","生理弯曲","椎间孔","关节突关节","椎管前后径"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱侧位片或斜位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["侧位片可观察什么","脊柱生理弯曲和椎间隙","腰段椎间孔大小形态","椎管前后径","左右斜位片观察颈椎间孔"]}
{"id":"KB-IR-DX-0008","title":"腰椎斜位功能位及张口位可用于特定脊柱结构观察","content":"腰椎斜位片主要用于观察椎弓、峡部有无骨折或断裂，以及椎关节突关节情况。过屈位和过伸位功能片主要适用于需要了解某段椎体间稳定性时，与常规侧位片对比进行动态观察。张口正位片则主要用于观察寰枢关节结构。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["腰椎斜位片","椎弓","峡部","功能位","张口正位片","寰枢关节"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["腰椎斜位片或功能位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["腰椎斜位片观察什么","椎弓峡部骨折断裂","过屈过伸功能位","椎体间稳定性","张口正位片观察寰枢关节"]}
{"id":"KB-IR-DX-0009","title":"X线断层片可用于显示普通平片不清的细微结构","content":"X线断层片主要用于显示普通平片不易清楚显示的细微结构，例如齿状突基底部骨折，以及椎体内有无死骨存在等情况。对于需要进一步明确局部细节的病变，断层片可提供补充影像依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["X线断层片","细微结构","齿状突基底部骨折","死骨","补充影像","脊柱影像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["普通平片显示不清时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["X线断层片主要用于什么","普通平片显示不清的细微结构","齿状突基底部骨折","椎体内有无死骨"]}
{"id":"KB-IR-DX-0010","title":"三维C臂及NaviLink3D可提升骨科导航精度与流程效率","content":"具有190°运动轨道的三维C臂适用于上肢、下肢骨与关节、胸部、腰椎、骨盆与臀部以及上颌区域等部位的三维成像。该类C臂可配备NaviLink3D等直接3D导航界面，将C臂成像能力与高精度外科导航结合，无需对三维成像解剖结构进行人工配准，有助于提高骨科导航准确性并优化临床工作流程。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["三维C臂","190度运动轨道","NaviLink3D","3D导航界面","骨科导航","工作流程优化"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["骨科三维成像与导航时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","下肢","胸腹部","腰背","骨盆"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["三维成像190度运动轨道","三维C臂","NaviLink3D","直接3D导航界面","提高骨科导航准确性"]}
{"id":"KB-IR-DX-0011","title":"CT在临床中可用于精细显示骨与软组织病变","content":"CT检查具有较高的空间分辨率，可较清晰地显示骨结构、关节面、椎管及周围软组织情况。在临床应用中，CT有助于发现普通X线不易明确的骨折、骨质破坏、椎管狭窄及邻近组织病变，并可为诊断、术前评估和治疗方案制定提供重要依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["CT","临床应用","临床价值","骨结构","软组织","术前评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["CT影像评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","骨盆","胸腹部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["CT的临床应用及价值","CT显示骨与软组织病变","CT用于术前评估","普通X线不易明确的病变"]}
{"id":"KB-IR-DX-0012","title":"CT及CT脊髓造影可清楚显示脊髓与椎管结构关系","content":"由于脊髓被骨性椎管及其邻近结构遮挡，普通脊柱X线片较难直接显示。CT扫描可形成轴位图像，联合CT脊髓造影后，可较清楚地显示脊髓与骨性椎管及周围结构之间的相互关系，为相关病变判断提供依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["CT","CT脊髓造影","脊髓","骨性椎管","轴位图像","结构关系"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊髓及椎管结构评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊髓被骨性椎管遮挡","CT扫描成轴位图像","CT脊髓造影","显示脊髓与椎管结构关系"]}
{"id":"KB-IR-DX-0013","title":"CT脊髓造影可用于评估椎管内软组织病变","content":"CT脊髓造影可用于评估椎管内软组织病变，例如脊髓肿瘤、脊髓空洞症、韧带骨化、脊髓血管畸形、阿-希畸形、粘连性蛛网膜炎及脊髓萎缩等情况。该检查有助于显示病变范围及其与椎管内结构的关系，为诊断提供影像依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["CT脊髓造影","椎管内软组织病变","脊髓肿瘤","脊髓空洞症","蛛网膜炎","脊髓萎缩"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["椎管内软组织病变评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["medium","high"],"evidence_level":"internal_sop","retrieval_hints":["CT脊髓造影用于什么病变","椎管内软组织病变","脊髓肿瘤和脊髓空洞症","粘连性蛛网膜炎","脊髓萎缩"]}
{"id":"KB-IR-DX-0014","title":"MRI在临床中可用于显示软组织与神经结构病变","content":"MRI具有良好的软组织分辨能力，可较清晰地显示脊髓、神经根、椎间盘、韧带及周围软组织情况。在临床应用中，MRI对于脊柱和关节相关疾病的早期发现、病变范围判断、神经受压评估及治疗方案制定具有重要价值。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["MRI","临床应用","临床价值","软组织","神经结构","病变评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["MRI影像评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","关节","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["MRI的临床应用及价值","MRI显示软组织与神经结构","MRI评估神经受压","MRI用于病变范围判断"]}
{"id":"KB-IR-DX-0015","title":"MRI可在无创和无电离辐射条件下显示解剖与病理改变","content":"MRI提供了一种在活体状态下无创了解人体解剖细节，甚至病理改变的方法，并且不涉及电离辐射。该特点使其在需要反复评估或重视软组织显示的临床场景中具有明显优势。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["MRI","无创","无电离辐射","解剖细节","病理改变","临床优势"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["MRI检查价值说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["MRI无创了解人体解剖细节","MRI无电离辐射","病理改变","MRI临床优势"]}
{"id":"KB-IR-DX-0016","title":"MRI对脊柱和关节病变异常改变具有较高敏感性","content":"MRI能够较好地显示脊柱和关节病变细节，是诊断相关异常改变较为敏感且无创的方法。对于普通X线及CT难以明确诊断或诊断存在困难的情况，MRI可作为进一步评估的重要选择。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["MRI","脊柱病变","关节病变","敏感性","无创","进一步评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊柱或关节MRI评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","关节","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["MRI能够很好显示脊柱关节病变细节","MRI最敏感无创方法","X线及CT无法诊断时","MRI作为进一步选择"]}
{"id":"KB-IR-DX-0017","title":"MRI可直接显示关节软组织及肌肉病变","content":"MRI能够直接显示滑膜、纤维软骨、椎间盘、半月板、肌腱及韧带等软组织结构的异常改变，例如膝关节交叉韧带损伤等。对于肌肉疾病，如肌肉炎症、创伤及肿瘤，MRI同样是较优的成像方法。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["MRI","滑膜","纤维软骨","半月板","肌腱","韧带","肌肉病变"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["关节或肌肉MRI评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["关节","膝关节","四肢","脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["MRI直接显示滑膜纤维软骨","椎间盘半月板","肌腱韧带异常改变","肌肉炎症创伤肿瘤","MRI最佳成像方法"]}
{"id":"KB-IR-DX-0018","title":"医用红外热成像仪可用于体表温度分布评估","content":"医用红外热成像仪是一种通过接收人体表面红外辐射并转换为热图的检查设备，可用于观察体表温度分布及局部热异常情况。其在临床中可辅助进行功能性评估、异常区域筛查及疗效随访，但应结合主诉、查体及其他检查结果综合判断。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["医用红外热成像仪","红外热成像","体表温度","热图","功能评估","筛查随访"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热图检查与评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["医用红外热成像仪","体表温度分布评估","热图检查设备","局部热异常","功能评估与随访"]}
{"id":"KB-IR-DX-0019","title":"医用红外热像技术可将人体红外辐射信息转化为热图","content":"医用红外热像技术是医学技术、红外摄像技术及计算机多媒体技术相结合的产物。该技术利用人体自身可作为天然红外辐射源的特点，通过光学扫描系统采集人体体表红外辐射能量，经过光电信号转换与处理，最终以红外热图形式记录人体体表红外辐射信息，是一种先进的非接触成像探测技术。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["医用红外热像技术","红外辐射","热图","非接触成像","光电转换","探测技术"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热像技术原理说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["医用红外热像技术","人体天然红外辐射源","光学扫描系统采集体表红外辐射","红外热图","非接触成像探测技术"]}
{"id":"KB-IR-DX-0020","title":"医用红外热像仪可作为CT和MRI之外的新型医疗设备","content":"以医用红外热像技术为基础的医用红外热像仪，可作为CT和MRI之外的一类新型医疗设备。其主要特点是以非接触方式获取体表温度与热分布信息，可为临床功能评估和辅助判断提供补充依据。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["医用红外热像仪","新型医疗设备","CT","MRI","非接触","体表温度"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["红外设备定位说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["医用红外热像仪是新型医疗设备","CT MRI之外","非接触获取体表温度","热分布信息","辅助判断"]}
{"id":"KB-IR-DX-0021","title":"医用红外热像仪具有安全无创和高灵敏度等优势","content":"医用红外热像仪在应用中具有安全、无创、信息量较大、灵敏度高及无有害辐射等优势，已成为人体无损检测设备中具有较高实用价值的工具之一。其在临床医学及相关科学研究中应用广泛，并能够取得较好的辅助评估效果。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["医用红外热像仪","安全无创","高灵敏度","无有害辐射","无损检测","临床应用"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外设备优势说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["医用红外热像仪优势","安全无创","信息量大灵敏度高","无有害辐射","无损检测设备"]}
{"id":"KB-IR-DX-0022","title":"红外热成像技术通过采集红外辐射生成体表热图","content":"红外热成像技术的工作原理是接收人体体表发出的红外辐射能量，并通过探测器、光电转换及计算机处理系统，将这些辐射信息转换为可视化热图。通过热图可反映体表不同区域的温度分布及相对差异，从而为功能评估和异常区域筛查提供依据。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","工作原理","红外辐射","热图","光电转换","温度分布"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热成像原理说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术工作原理","采集红外辐射生成热图","光电转换","体表温度分布","异常区域筛查"]}
{"id":"KB-IR-DX-0023","title":"红外热成像可通过信号转换形成可分析的热图图像","content":"红外热成像技术的工作原理是利用红外探测器接收目标发出的红外辐射能量，并经过信号处理，将其转换为便于测量和分析的电信号，再通过数字信号处理、模数转换等过程，最终形成可直观查看和分析的热图图像。通过对热信息的分析，可辅助判断目标内部功能或结构异常情况。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像","红外探测器","数字信号处理","模数转换","热图图像","热信息分析"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热成像详细原理说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外探测器接收红外辐射能","数字信号处理和模数转换","形成可分析热图图像","通过热信息分析探查内部情况"]}
{"id":"KB-IR-DX-0024","title":"红外热成像自20世纪60年代起已用于医学辅助诊断","content":"自20世纪60年代起，红外热成像技术便已应用于现代医学，可作为炎症、肿瘤等疾病的辅助诊断手段，并在疗效评价和随访观察中发挥作用。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像","20世纪60年代","辅助诊断","炎症","肿瘤","疗效评价"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["红外热成像发展与应用说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["20世纪60年代红外热成像应用","现代医学辅助诊断","炎症肿瘤","疗效评价","随访观察"]}
{"id":"KB-IR-DX-0025","title":"红外热成像技术可为中医药学提供新的诊疗与科研手段","content":"红外热成像技术已较广泛地应用于中医药学领域，可为中医诊断、中医临床疗效评价及中医科研等方面提供新的思路和技术手段。通过体表热图信息分析，可为中医辨证及疗效观察提供辅助参考。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","中医药学","中医诊断","疗效评价","中医科研","辅助参考"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["中医热成像应用说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术应用于中医药学","中医诊断","中医临床疗效评价","中医科研","新的思路和手段"]}
{"id":"KB-IR-DX-0026","title":"红外热成像技术可用于骨伤及关节疾病评估","content":"红外热成像技术在骨伤及关节疾病中具有一定应用价值，可用于观察局部体表温度变化、热异常分布及左右对称差异。其可辅助评估炎症反应、损伤范围、功能状态及治疗前后变化，但判读时仍应结合主诉、查体及其他影像检查综合分析。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["红外热成像技术","骨伤","关节疾病","体表温度变化","热异常","综合评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["骨伤及关节疾病热图评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["关节","四肢","脊柱背部","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术在骨伤及关节疾病中的应用","局部体表温度变化","热异常分布","左右对称差异","治疗前后变化"]}
{"id":"KB-IR-DX-0027","title":"红外热成像在骨伤科诊断分型及疗效评价中具有应用价值","content":"红外热成像技术在骨伤科具有较大的应用空间，不仅有助于骨关节疾病的临床诊断，还可用于基础研究。在颈肩腰腿痛等疾病的诊断、辨证分型，以及慢性腰肌劳损的诊断、分期和疗效评价等方面，均具有较好的辅助应用效果。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note","treatment_plan_text"],"tags":["红外热成像技术","骨伤科","辨证分型","颈肩腰腿痛","慢性腰肌劳损","疗效评价"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["骨伤科红外热图应用说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","腰背","四肢","关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术在骨伤科的应用","骨关节疾病临床诊断","颈肩腰腿痛辨证分型","慢性腰肌劳损诊断分期疗效评价"]}
{"id":"KB-IR-DX-0028","title":"急慢性颈肩痛患者热像表现可存在差异","content":"通过观察颈肩痛患者的红外热像图可发现，急性颈肩痛患者疼痛部位温度通常明显高于周围组织；而慢性颈肩痛患者疼痛部位的热像表现则不尽相同，多数呈低温改变，少数可呈高温改变。判读时应结合病程长短及临床表现综合分析。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["颈肩痛","急性疼痛","慢性疼痛","高温改变","低温改变","热像差异"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["颈肩痛热图判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["急性颈肩痛疼痛部位温度高","慢性颈肩痛多呈低温改变","少数呈高温改变","颈肩痛热像特征"]}
{"id":"KB-IR-DX-0029","title":"红外热像可辅助评估腰椎间盘突出症但定位能力有限","content":"红外热像图可作为腰椎间盘突出症的辅助诊断途径，能够反映该病引起的体表温度变化。但现有实验观察提示，红外热像图尚不能对病变椎间盘进行准确定位，因此应结合临床表现及其他影像学检查综合判断。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["腰椎间盘突出症","红外热像图","辅助诊断","体表温度变化","定位能力有限","综合判断"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["腰椎间盘突出症热图评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["腰背","脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热像图作为腰椎间盘突出症辅助诊断","体表温度变化","尚不能准确定位病变椎间盘","综合判断"]}
{"id":"KB-IR-DX-0030","title":"红外热像对膝关节骨性关节炎具有一定诊断价值","content":"红外热像图能够较准确地呈现膝关节骨性关节炎患者局部温度及热像图变化，对膝关节疾病评估具有一定的辅助诊断价值。判读时仍应结合临床症状、体征及其他检查结果综合分析。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["红外热像图","膝关节骨性关节炎","局部温度","热像变化","辅助诊断","膝关节疾病"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["膝关节骨性关节炎热图评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["红外热像图对膝关节骨性关节炎","局部温度及热像图变化","有一定诊断价值","膝关节疾病评估"]}
{"id":"KB-IR-DX-0031","title":"红外热成像技术具有无创无辐射和动态评估等特点","content":"红外热成像技术具有无创、无接触、无有害辐射、可重复检查、信息量较大及动态评估等特点。其能够较直观地反映体表温度分布和相对差异，适用于功能状态观察、异常区域筛查及治疗前后变化的辅助评估。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","无创","无辐射","动态评估","体表温度分布","可重复检查"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热成像技术特点说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术特点","无创无接触无有害辐射","可重复检查","动态评估","体表温度分布"]}
{"id":"KB-IR-DX-0032","title":"红外热成像在中医药临床和科研领域已取得一定成果","content":"红外热成像技术在中医药领域的临床应用和科研研究中已经取得了一定成果。其在中医辨证辅助、疗效观察及相关机制研究等方面展现出较好的应用前景和实际价值。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","中医药领域","临床应用","科研研究","辨证辅助","应用成果"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["中医药热成像应用总结时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术在中医药领域","临床和科研应用","取得不小成果","中医辨证辅助","应用前景"]}
{"id":"KB-IR-DX-0033","title":"红外热成像技术具有安全环保和费用较低等优点","content":"红外热成像技术不会对人体造成创伤，也不会污染环境，具有无辐射、非接触、安全、实用及费用相对较低等优点。该特点使其适用于临床筛查、功能评估及重复随访等应用场景。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","无辐射","非接触","安全","费用低廉","环保"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热成像优势说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["红外热成像技术不会伤害人体","不会污染环境","无辐射非接触","安全实用费用低廉","重复随访"]}
{"id":"KB-IR-DX-0034","title":"红外热图可将人体寒热信息客观化可视化和数据化","content":"红外热成像技术能够较精确地呈现人体体表各部位温度分布，并形成颜色鲜明的热图。人体寒热信息由此实现客观化、可视化和数据化，这些特点构成了该技术得以广泛应用的重要基础。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热图","温度分布","客观化","可视化","数据化","寒热信息"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外热图特点说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["头面部","颈肩","胸腹部","脊柱背部","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["体表各部位温度精确呈现","热图颜色鲜明","寒热信息客观化可视化数据化","广泛应用前提"]}
{"id":"KB-IR-DX-0035","title":"红外热成像在中医药量化和现代化研究中具有发展前景","content":"红外热成像技术在中医药领域研究中具有较大的发展空间和良好的应用前景。该技术有望为中医药量化研究和现代化研究提供有力支持，并可能成为现代中医临床诊疗中的重要辅助工具。","category":"interpretation_rule","report_sections":["report_note","diagnosis","doctor_opinion"],"tags":["红外热成像技术","中医药量化","中医药现代化","发展前景","辅助工具","中医临床"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["中医药现代化应用展望时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["中医药领域更大发展空间","中医药量化和现代化研究","良好发展前景","现代中医临床诊疗辅助工具","中医CT"]}
{"id":"KB-IR-TX-0002","title":"颈椎弧度牵引治疗仪可用于颈椎功能恢复辅助治疗","content":"颈椎弧度牵引治疗仪是一种用于颈椎疾病康复与功能恢复的辅助治疗设备，可通过相对符合颈椎生理曲度的牵引方式，帮助缓解颈部肌肉紧张、减轻局部负荷并改善颈椎功能状态。具体应用时应结合患者病情和适应证综合评估。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["颈椎弧度牵引治疗仪","颈椎","牵引治疗","功能恢复","康复设备","辅助治疗"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["颈椎康复治疗评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["颈椎弧度牵引治疗仪","颈椎牵引治疗","功能恢复辅助治疗","康复设备"]}
{"id":"KB-IR-TX-0003","title":"颈椎弧度牵引治疗仪参照中医临床推广技术设计","content":"该治疗仪参照国家中医药管理局中医临床推广技术项目《仰卧拔伸手法治疗颈椎病技术》设计而成，旨在将传统颈椎病治疗思路与现代设备结构相结合，用于颈椎病相关康复治疗。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["颈椎弧度牵引治疗仪","中医临床推广技术","仰卧拔伸手法","颈椎病","设计依据"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["介绍设备设计依据时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["参照仰卧拔伸手法治疗颈椎病技术设计", "国家中医药管理局中医临床推广技术项目", "颈椎弧度牵引治疗仪设计依据"]}
{"id":"KB-IR-TX-0004","title":"颈椎弧度牵引治疗仪可通过额颈受力和局部加热协同治疗","content":"该设备将牵引着力点设计在额部及颈部。治疗过程中，颈托内的纤维加热布可对颈椎局部进行加热，辅助缓解疼痛及麻木症状；同时可配合中药封包使用，以增强治疗辅助效果。自动升降的颈托可托住颈部，使颈椎在保持一定生理曲度状态下进行牵引；具有伸缩功能的机械手可在牵引时固定额部，以减少传统悬吊式牵引的局部压迫。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["额部及颈部牵引","纤维加热布","中药封包","自动升降颈托","机械手固定额部","减轻压迫"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["介绍设备结构与治疗方式时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["额部及颈部着力点", "纤维加热布缓解疼痛麻木", "中药封包", "自动升降颈托", "机械手固定额部"]}
{"id":"KB-IR-TX-0005","title":"电脑数控弧度牵引对老年及症状较重颈椎病患者有一定适用性","content":"新型弧度牵引采用电脑数控技术，由程序控制治疗过程，具有安全、简单、可靠等特点。对于年老及部分症状较重的颈椎病患者，该类设备具有一定应用价值。院内示例设备型号可见HKM-2100-2型颈椎弧度牵引治疗仪。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["电脑数控技术","安全简单可靠","老年患者","颈椎病","HKM-2100-2"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["介绍设备特点与适用人群时"],"contraindications":[],"patient_scope":["adult","elderly"],"body_parts":["颈肩"],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["电脑数控弧度牵引", "安全简单可靠", "年老颈椎病患者", "HKM-2100-2型颈椎弧度牵引治疗仪"]}
{"id":"KB-IR-TX-0006","title":"毫针是临床常用的针灸器械之一","content":"毫针是目前临床最常用的针灸器械之一，现代临床所用毫针多由不锈钢制成，适用于多种针刺治疗场景。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["毫针","针灸器械","不锈钢","临床常用","针刺治疗"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["介绍针灸器械时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["毫针是最常用针灸器械", "现代临床毫针多由不锈钢制成", "针刺治疗"]}
{"id":"KB-IR-TX-0007","title":"毫针结构一般包括针尖针身针根针柄和针尾","content":"毫针的基本结构一般分为针尖、针身、针根、针柄和针尾，各部分共同构成完整针具，以满足针刺操作需要。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["毫针结构","针尖","针身","针根","针柄","针尾"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["介绍毫针结构时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["毫针结构分为", "针尖针身针根针柄针尾", "完整针具"]}
{"id":"KB-IR-TX-0008","title":"毫针规格主要按针身长度和粗细区分","content":"毫针的规格主要依据针身的长度和粗细进行区分，临床上存在多种不同型号，可根据治疗部位、操作需要及患者情况选择合适规格。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["毫针规格","针身长度","针身粗细","不同型号","器械选择"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["选择毫针规格时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["毫针规格主要以针身长和粗细区分", "多种不同型号", "选择合适规格"]}
{"id":"KB-IR-TX-0009","title":"毫针操作需要一定指力和熟练手法","content":"由于毫针针体较为柔软，针刺操作时需要一定的指力和较为熟练的手法，以保证进针、行针及整体操作的稳定性和准确性。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["毫针操作","指力","熟练手法","针体柔软","稳定性"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["进行针刺操作培训或说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["毫针针体较软", "需要一定指力和熟练手法", "进针行针稳定性"]}
{"id":"KB-IR-TX-0010","title":"针刺操作中刺手与押手各有分工","content":"针刺操作中通常以右手持针施术，称为“刺手”，一般由拇指、示指和中指夹持针柄，用于掌握针具并施行手法操作；左手常作为“押手”，主要用于按压所刺部位、固定腧穴位置或辅助针身进针，以提高操作稳定性。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["刺手","押手","针刺操作","持针","固定腧穴","辅助进针"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["讲解针刺基本操作时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["右手持针称为刺手", "左手为押手", "固定腧穴位置", "辅助针身进针"]}
{"id":"KB-IR-TX-0011","title":"押手主要用于固定腧穴位置和辅助进针","content":"针刺操作中，左手有所依附并协助进针者称为“押手”，其主要作用是按压所刺部位、固定腧穴位置并辅助针身进针，以提高针刺操作的稳定性和准确性。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["押手","固定腧穴","辅助进针","针刺操作","稳定性"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["讲解押手作用时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["押手是什么意思", "固定腧穴位置", "辅助进针", "右主推之左持而御之"]}
{"id":"KB-IR-TX-0012","title":"针刺治疗作用重在调气和得气","content":"毫针针刺的治疗作用主要在于“调气”，而得气与否又与针刺疗效密切相关，直接影响治疗效果。针刺入腧穴后，应通过适当行针促使得气，以增强治疗反应。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["调气","得气","针刺疗效","毫针","治疗作用"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["讲解针刺治疗机制时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["用针之类在于调气", "得气与否与疗效密切相关", "针刺治疗作用", "促使得气"]}
{"id":"KB-IR-TX-0013","title":"针刺行针可采用提插捻转及多种辅助手法","content":"针刺入腧穴后，为促使得气并调节针感，可运用提插、捻转等基本手法，并辅以循法、刮柄法、弹柄法、搓柄法、摇柄法及震颤法等操作，同时可结合补泻手法进行调节。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["行针","提插","捻转","刮柄法","弹柄法","补泻手法"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["讲解行针手法时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["行针基本手法", "提插捻转", "刮柄法弹柄法", "补泻操作", "调节针感"]}
{"id":"KB-IR-TX-0014","title":"针刺方向角度和深浅应结合病情体质规范掌握","content":"针刺过程中，针刺方向、角度和深浅度均需准确掌握，并应根据施术部位、病情需要、治疗目的、患者体质及形体胖瘦等具体情况灵活确定。规范操作有助于增强针感、提高疗效，并预防异常情况发生。","category":"treatment_guideline","report_sections":["treatment_plan_text","doctor_opinion","report_note"],"tags":["针刺方向","针刺角度","针刺深浅","规范操作","提高疗效","预防异常"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["进行针刺操作说明时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium"],"evidence_level":"internal_sop","retrieval_hints":["针刺方向角度深浅必须准确掌握", "根据施术部位病情体质而定", "规范操作增强针感提高疗效", "预防异常情况发生"]}
