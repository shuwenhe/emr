{"id":"KB-IR-SOP-0001","title":"热成像检查前静息要求","content":"红外热成像检查前宜静息15至20分钟，避免剧烈运动、热水浴、饮酒及外用刺激性药物，以减少短时体表温度波动对判读的干扰。","category":"sop_preparation","report_sections":["report_note"],"tags":["检查准备","静息","环境控制"],"source":"院内热成像检查SOP v1.0","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["门诊常规热成像采集"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":[],"evidence_level":"internal_sop","retrieval_hints":["检查前准备","静息20分钟","避免热刺激"]}
{"id":"KB-IR-INT-0001","title":"左右对称差异优先于绝对温度","content":"体表温度判读应优先关注左右对称区域的相对温差、局部热点或冷点分布及动态变化，不宜仅依据单次绝对温度值直接下结论。","category":"interpretation_symmetry","report_sections":["diagnosis","doctor_opinion"],"tags":["对称性","温差","判读原则"],"source":"热成像判读规范（试行）","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["左右对称ROI可比较","采集姿势一致"],"contraindications":["环境温度波动明显时慎用单次结论"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["左右温差","ROI对称","相对温度"],"structured_advice":{"interpretation_focus":"symmetry_before_absolute_temperature"}}
{"id":"KB-IR-INT-0002","title":"局部高温区提示炎症或应激风险","content":"若局部区域温度明显高于周围组织或对侧对应区域，可提示炎症反应、应激负荷增加或局部循环活跃，应结合主诉、触诊及必要的实验室或影像检查综合评估。","category":"interpretation_hotspot","report_sections":["diagnosis","doctor_opinion"],"tags":["热点","高温","炎症风险"],"source":"区域温度异常判读共识（摘要）","source_type":"consensus","priority":8,"status":"active","applicable_conditions":["存在局部热点","图像质量可判读"],"contraindications":["近期外部热刺激未排除时慎解释"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","膝关节"],"risk_levels":["medium","high"],"evidence_level":"consensus","retrieval_hints":["局部热点","温度升高","炎症可能"]}
{"id":"KB-IR-RISK-0001","title":"报告结论按风险等级表达","content":"热成像报告结论宜按低、中、高风险分层表达。低风险强调生活方式调整与观察，中风险强调短期复评及针对性干预，高风险应明确建议进一步检查或及时专科就诊。","category":"risk_stratification","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["风险分层","报告结论","措辞规范"],"source":"红外热成像评估报告模板说明","source_type":"guideline","priority":9,"status":"active","applicable_conditions":["生成最终报告结论"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["低中高风险","风险分层","结论表达"],"structured_advice":{"output_style":"risk_layered"}}
{"id":"KB-IR-TX-0001","title":"中等风险病例建议短期复评","content":"对于中等风险热成像异常，治疗建议宜包含减轻局部负荷、针对异常区域的理疗或灸疗评估，并建议于7至14天内复测热成像，比较ROI温差及异常区域范围变化。","category":"follow_up_rule","report_sections":["treatment_plan_text","doctor_opinion"],"tags":["复评","中风险","治疗建议"],"source":"门诊随访流程规范","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["风险等级为medium"],"contraindications":["出现红旗症状时不应仅安排常规复评"],"patient_scope":["adult"],"body_parts":["颈肩","腰背"],"risk_levels":["medium"],"evidence_level":"internal_sop","retrieval_hints":["7到14天复评","中风险复查","趋势比较"],"structured_advice":{"follow_up_days_min":7,"follow_up_days_max":14,"action":"复测热成像并比较ROI变化"}}
{"id":"KB-IR-SAFE-0001","title":"存在红旗情况时优先转诊评估","content":"若患者存在发热、急性外伤、活动性出血、严重感染、持续剧烈疼痛、神经功能异常或肿瘤治疗期等情况，报告应提示谨慎解释热成像结果，并优先建议专科评估或转诊。","category":"contraindication","report_sections":["doctor_opinion","treatment_plan_text","report_note"],"tags":["禁忌","转诊","安全边界"],"source":"临床安全边界清单 v2","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["存在红旗症状或特殊病情"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["high"],"evidence_level":"guideline","retrieval_hints":["转诊提醒","红旗症状","谨慎干预"],"structured_advice":{"action":"refer_specialist","urgency":"high"}}
{"id":"KB-IR-SOP-0002","title":"黑体校准可提高温度测量准确性","content":"为保证温度测量的准确性，仪器可配合黑体进行校准。打开黑体并预热20分钟后，将红外摄像头对准黑体，点击“修改区域”，待光标在摄图区域变为十字后，将其移动至参考黑体热图中心，单击鼠标左键即可完成校准。每次开机后，以及对温度精度要求较高时，均可进行黑体校准。","category":"sop_preparation","report_sections":["report_note","health_advice","doctor_opinion"],"tags":["黑体校准","温度测量","精度","预热20分钟","修改区域","红外摄像头"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外设备开机后","对温度精度要求较高时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["黑体校准","预热20分钟","点击修改区域","参考黑体热图中心","提高温度测量准确性"]}
{"id":"KB-IR-SOP-0003","title":"上半身正侧位标准图可作为采集参考","content":"上半身热成像采集时，宜参照上半身正位图和侧位图的标准体位进行拍摄，以保证受检者姿势一致、解剖区域暴露充分、左右对称区域可比，从而减少因体位偏差带来的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","胸腹部","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身正侧位标准图","正位图","侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0004","title":"上半身背侧位标准图可作为采集参考","content":"上半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证背部、肩胛区及脊柱旁区域显示完整，减少因身体旋转、遮挡或姿势不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","背侧位","标准图","采集参考","体位要求","背部热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身背侧位标准图","背侧位","标准体位","背部采集参考","减少判读偏差"]}
{"id":"KB-IR-SOP-0005","title":"下半身正侧位标准图可作为采集参考","content":"下半身热成像采集时，宜参照下半身正位图和侧位图的标准体位进行拍摄，以保证骨盆、髋部、下肢等解剖区域显示完整，左右对应区域具备可比性，从而减少因站姿偏斜、遮挡或体位不一致造成的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","髋部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身正侧位标准图","下半身正位图","下半身侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0006","title":"下半身背侧位标准图可作为采集参考","content":"下半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证臀部、大腿后侧、小腿后侧等区域显示完整，减少因身体旋转、遮挡或站姿不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","背侧位","标准图","采集参考","体位要求","后侧热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","臀部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身背侧位标准图","背侧位","后侧采集参考","标准体位","减少判读偏差"]}
{"id":"KB-IR-SOP-0007","title":"膝关节正侧位标准图可作为采集参考","content":"膝关节热成像采集时，宜参照膝关节正位图和侧位图的标准体位进行拍摄，以保证膝前区、膝外侧及周围软组织区域显示清晰，便于比较双侧膝关节温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["膝关节","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["膝关节热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["膝关节正侧位","膝关节正位图","膝关节侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0008","title":"膝关节背侧位标准图可作为采集参考","content":"膝关节背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证腘窝区、膝后侧及周围软组织区域显示清晰，便于观察后侧温度分布及局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["膝关节","背侧位","标准图","采集参考","体位要求","腘窝区"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["膝关节背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["膝关节背侧位","膝后侧","腘窝区","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0009","title":"足踝部正侧位标准图可作为采集参考","content":"足踝部热成像采集时，宜参照足踝部正位图和侧位图的标准体位进行拍摄，以保证踝关节、足背、足底及周围软组织区域显示清晰，便于比较双侧温度分布和识别局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["足踝部","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["足踝部热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["踝关节","足部","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["足踝部正侧位","足踝部正位图","足踝部侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0010","title":"足踝部背侧位标准图可作为采集参考","content":"足踝部背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证跟腱区、足跟、踝后侧及周围软组织区域显示清晰，便于观察后侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["足踝部","背侧位","标准图","采集参考","体位要求","跟腱区"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["足踝部背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["踝关节","足部","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["足踝部背侧位","踝后侧","跟腱区","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0011","title":"手肘部背侧位标准图可作为采集参考","content":"手肘部背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证肘后区、鹰嘴周围及邻近软组织区域显示清晰，便于观察后侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["手肘部","背侧位","标准图","采集参考","体位要求","鹰嘴"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["手肘部背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","肘关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["手肘部背侧位","肘后区","鹰嘴","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0012","title":"手肘部桡侧位标准图可作为采集参考","content":"手肘部桡侧位热成像采集时，宜参照桡侧位标准图进行体位摆放和图像采集，以保证肘外侧、桡骨头周围及邻近软组织区域显示清晰，便于观察桡侧温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["手肘部","桡侧位","标准图","采集参考","体位要求","桡骨头"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["手肘部桡侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","肘关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["手肘部桡侧位","肘外侧","桡骨头","标准体位","采集参考"]}
{"id":"KB-IR-INT-0003","title":"热图判读应结合主诉与查体综合分析","content":"在了解生理热图与干扰热图特征后，应结合患者主诉及查体体征进行综合分析。排除生理性改变和干扰热像后，再进行疾病诊断，并结合临床情况给予对症治疗。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","treatment_plan_text"],"tags":["生理热图","干扰热图","主诉","查体体征","综合分析","对症治疗"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["热图判读与临床分析时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["结合主诉和查体综合分析","排除生理与干扰热像","再进行疾病诊断","对症治疗"]}
{"id":"KB-IR-DX-0001","title":"脊柱关节病相关检查诊断设备可用于综合评估","content":"脊柱关节病的检查与诊断宜结合多种设备和方法进行综合评估，可包括红外热成像、X线、CT、MRI及实验室检查等。实际应用中应结合患者主诉、体征及病程特点，选择合适的检查设备和诊断路径。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱关节病","检查设备","诊断设备","综合评估","红外热成像","影像检查"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊柱关节病相关评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱关节病相关检查诊断设备","红外热成像和X线CTMRI","综合评估","诊断路径"]}
{"id":"KB-IR-DX-0002","title":"X线检查对脊柱和关节骨结构病变诊断具有重要作用","content":"骨组织属于人体硬组织，含钙量较多、密度较高，X线不易穿透。由于脊柱和关节病变常可反映为骨结构改变，因此X线检查在相关疾病诊断中具有重要作用。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["骨组织","X线检查","脊柱","关节","骨结构改变","影像诊断"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["脊柱和关节影像评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","膝关节","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["骨组织含钙量多密度高","X线不易穿透","骨结构改变","X线检查对诊断重要"]}
{"id":"KB-IR-DX-0003","title":"X线检查可为诊断治疗及疗效判断提供依据","content":"通过X线检查，不但可以了解骨与关节损伤或病变的部位、范围、性质、程度以及软组织情况，为疾病诊断和鉴别诊断提供依据，也可为治疗方案制定提供参考。在治疗过程中，还可用于判断骨折脱位的整复、牵引及固定等治疗效果，并观察病变发展和预后情况。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note","treatment_plan_text"],"tags":["X线检查","诊断依据","鉴别诊断","治疗依据","疗效判断","预后评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["骨与关节影像评估及治疗随访时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","膝关节","骶髂关节"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["X线检查可了解部位范围性质程度","为诊断和鉴别诊断提供依据","判断骨折脱位整复牵引固定效果","观察病变发展和预后"]}
{"id":"KB-IR-DX-0004","title":"脊柱X线检查主要包括平片检查和脊髓造影","content":"脊柱X线检查的常用方式主要包括平片检查和脊髓造影。临床上可根据病变部位、症状特点及诊断需要，选择适当的检查方式，以辅助判断脊柱结构及相关病变情况。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱X线检查","平片检查","脊髓造影","检查方式","脊柱病变","影像学"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱影像学检查时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱X线检查主要有平片检查和脊髓造影","平片检查","脊髓造影","脊柱影像检查方式"]}
{"id":"KB-IR-DX-0005","title":"脊柱平片常规摄片可包括正位侧位和斜位","content":"脊柱平片检查的常规摄片体位一般包括正位、侧位和左右斜位。根据病情需要，还可加拍张口位、过屈位、过伸位等功能位以及体层摄影片，以提高对特定病变的显示和判断能力。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱平片","正位","侧位","左右斜位","张口位","功能位"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱平片检查时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["脊柱平片检查常规摄片","正位侧位左右斜位","张口位","过屈过伸功能位","体层摄影片"]}
{"id":"KB-IR-DX-0006","title":"脊柱正位片可观察椎体序列与椎弓根等结构变化","content":"脊柱正位片主要用于观察脊柱有无侧弯，椎体结构及排列序列是否正常，以及椎间隙、椎弓根的形态、位置和间距变化。同时还可观察横突及椎旁软组织的异常改变，为脊柱病变判断提供依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱正位片","侧弯","椎体序列","椎间隙","椎弓根","椎旁软组织"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱正位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["正位片主要观察什么","脊柱有无侧弯","椎体结构及序列","椎弓根形态位置间距","椎旁软组织变化"]}
{"id":"KB-IR-DX-0007","title":"脊柱侧位片和斜位片可观察椎间孔及关节排列变化","content":"脊柱侧位片可用于观察脊柱生理弯曲、椎体结构及排列序列、椎间隙以及关节突关节的排列情况，尤其有助于判断腰段椎间孔的大小和形态、椎管前后径及寰枕关节情况。左右斜位片则主要用于观察颈椎间孔大小及其周围骨质结构变化。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["脊柱侧位片","斜位片","生理弯曲","椎间孔","关节突关节","椎管前后径"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["脊柱侧位片或斜位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["侧位片可观察什么","脊柱生理弯曲和椎间隙","腰段椎间孔大小形态","椎管前后径","左右斜位片观察颈椎间孔"]}
{"id":"KB-IR-DX-0008","title":"腰椎斜位功能位及张口位可用于特定脊柱结构观察","content":"腰椎斜位片主要用于观察椎弓、峡部有无骨折或断裂，以及椎关节突关节情况。过屈位和过伸位功能片主要适用于需要了解某段椎体间稳定性时，与常规侧位片对比进行动态观察。张口正位片则主要用于观察寰枢关节结构。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["腰椎斜位片","椎弓","峡部","功能位","张口正位片","寰枢关节"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["腰椎斜位片或功能位片判读时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩","腰背"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["腰椎斜位片观察什么","椎弓峡部骨折断裂","过屈过伸功能位","椎体间稳定性","张口正位片观察寰枢关节"]}
{"id":"KB-IR-DX-0009","title":"X线断层片可用于显示普通平片不清的细微结构","content":"X线断层片主要用于显示普通平片不易清楚显示的细微结构，例如齿状突基底部骨折，以及椎体内有无死骨存在等情况。对于需要进一步明确局部细节的病变，断层片可提供补充影像依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["X线断层片","细微结构","齿状突基底部骨折","死骨","补充影像","脊柱影像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["普通平片显示不清时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","颈肩"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["X线断层片主要用于什么","普通平片显示不清的细微结构","齿状突基底部骨折","椎体内有无死骨"]}
{"id":"KB-IR-DX-0010","title":"三维C臂及NaviLink3D可提升骨科导航精度与流程效率","content":"具有190°运动轨道的三维C臂适用于上肢、下肢骨与关节、胸部、腰椎、骨盆与臀部以及上颌区域等部位的三维成像。该类C臂可配备NaviLink3D等直接3D导航界面，将C臂成像能力与高精度外科导航结合，无需对三维成像解剖结构进行人工配准，有助于提高骨科导航准确性并优化临床工作流程。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["三维C臂","190度运动轨道","NaviLink3D","3D导航界面","骨科导航","工作流程优化"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":7,"status":"active","applicable_conditions":["骨科三维成像与导航时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["上肢","下肢","胸腹部","腰背","骨盆"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["三维成像190度运动轨道","三维C臂","NaviLink3D","直接3D导航界面","提高骨科导航准确性"]}
{"id":"KB-IR-DX-0011","title":"CT在临床中可用于精细显示骨与软组织病变","content":"CT检查具有较高的空间分辨率，可较清晰地显示骨结构、关节面、椎管及周围软组织情况。在临床应用中，CT有助于发现普通X线不易明确的骨折、骨质破坏、椎管狭窄及邻近组织病变，并可为诊断、术前评估和治疗方案制定提供重要依据。","category":"interpretation_rule","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["CT","临床应用","临床价值","骨结构","软组织","术前评估"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["CT影像评估时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["脊柱背部","四肢","骨盆","胸腹部"],"risk_levels":["low","medium","high"],"evidence_level":"internal_sop","retrieval_hints":["CT的临床应用及价值","CT显示骨与软组织病变","CT用于术前评估","普通X线不易明确的病变"]}
