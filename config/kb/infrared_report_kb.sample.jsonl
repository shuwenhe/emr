{"id":"KB-IR-SOP-0001","title":"热成像检查前静息要求","content":"红外热成像检查前宜静息15至20分钟，避免剧烈运动、热水浴、饮酒及外用刺激性药物，以减少短时体表温度波动对判读的干扰。","category":"sop_preparation","report_sections":["report_note"],"tags":["检查准备","静息","环境控制"],"source":"院内热成像检查SOP v1.0","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["门诊常规热成像采集"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":[],"evidence_level":"internal_sop","retrieval_hints":["检查前准备","静息20分钟","避免热刺激"]}
{"id":"KB-IR-INT-0001","title":"左右对称差异优先于绝对温度","content":"体表温度判读应优先关注左右对称区域的相对温差、局部热点或冷点分布及动态变化，不宜仅依据单次绝对温度值直接下结论。","category":"interpretation_symmetry","report_sections":["diagnosis","doctor_opinion"],"tags":["对称性","温差","判读原则"],"source":"热成像判读规范（试行）","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["左右对称ROI可比较","采集姿势一致"],"contraindications":["环境温度波动明显时慎用单次结论"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","四肢"],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["左右温差","ROI对称","相对温度"],"structured_advice":{"interpretation_focus":"symmetry_before_absolute_temperature"}}
{"id":"KB-IR-INT-0002","title":"局部高温区提示炎症或应激风险","content":"若局部区域温度明显高于周围组织或对侧对应区域，可提示炎症反应、应激负荷增加或局部循环活跃，应结合主诉、触诊及必要的实验室或影像检查综合评估。","category":"interpretation_hotspot","report_sections":["diagnosis","doctor_opinion"],"tags":["热点","高温","炎症风险"],"source":"区域温度异常判读共识（摘要）","source_type":"consensus","priority":8,"status":"active","applicable_conditions":["存在局部热点","图像质量可判读"],"contraindications":["近期外部热刺激未排除时慎解释"],"patient_scope":["adult"],"body_parts":["颈肩","腰背","膝关节"],"risk_levels":["medium","high"],"evidence_level":"consensus","retrieval_hints":["局部热点","温度升高","炎症可能"]}
{"id":"KB-IR-RISK-0001","title":"报告结论按风险等级表达","content":"热成像报告结论宜按低、中、高风险分层表达。低风险强调生活方式调整与观察，中风险强调短期复评及针对性干预，高风险应明确建议进一步检查或及时专科就诊。","category":"risk_stratification","report_sections":["diagnosis","doctor_opinion","report_note"],"tags":["风险分层","报告结论","措辞规范"],"source":"红外热成像评估报告模板说明","source_type":"guideline","priority":9,"status":"active","applicable_conditions":["生成最终报告结论"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low","medium","high"],"evidence_level":"guideline","retrieval_hints":["低中高风险","风险分层","结论表达"],"structured_advice":{"output_style":"risk_layered"}}
{"id":"KB-IR-TX-0001","title":"中等风险病例建议短期复评","content":"对于中等风险热成像异常，治疗建议宜包含减轻局部负荷、针对异常区域的理疗或灸疗评估，并建议于7至14天内复测热成像，比较ROI温差及异常区域范围变化。","category":"follow_up_rule","report_sections":["treatment_plan_text","doctor_opinion"],"tags":["复评","中风险","治疗建议"],"source":"门诊随访流程规范","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["风险等级为medium"],"contraindications":["出现红旗症状时不应仅安排常规复评"],"patient_scope":["adult"],"body_parts":["颈肩","腰背"],"risk_levels":["medium"],"evidence_level":"internal_sop","retrieval_hints":["7到14天复评","中风险复查","趋势比较"],"structured_advice":{"follow_up_days_min":7,"follow_up_days_max":14,"action":"复测热成像并比较ROI变化"}}
{"id":"KB-IR-SAFE-0001","title":"存在红旗情况时优先转诊评估","content":"若患者存在发热、急性外伤、活动性出血、严重感染、持续剧烈疼痛、神经功能异常或肿瘤治疗期等情况，报告应提示谨慎解释热成像结果，并优先建议专科评估或转诊。","category":"contraindication","report_sections":["doctor_opinion","treatment_plan_text","report_note"],"tags":["禁忌","转诊","安全边界"],"source":"临床安全边界清单 v2","source_type":"guideline","priority":10,"status":"active","applicable_conditions":["存在红旗症状或特殊病情"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["high"],"evidence_level":"guideline","retrieval_hints":["转诊提醒","红旗症状","谨慎干预"],"structured_advice":{"action":"refer_specialist","urgency":"high"}}
{"id":"KB-IR-SOP-0002","title":"黑体校准可提高温度测量准确性","content":"为保证温度测量的准确性，仪器可配合黑体进行校准。打开黑体并预热20分钟后，将红外摄像头对准黑体，点击“修改区域”，待光标在摄图区域变为十字后，将其移动至参考黑体热图中心，单击鼠标左键即可完成校准。每次开机后，以及对温度精度要求较高时，均可进行黑体校准。","category":"sop_preparation","report_sections":["report_note","health_advice","doctor_opinion"],"tags":["黑体校准","温度测量","精度","预热20分钟","修改区域","红外摄像头"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":9,"status":"active","applicable_conditions":["红外设备开机后","对温度精度要求较高时"],"contraindications":[],"patient_scope":["adult"],"body_parts":[],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["黑体校准","预热20分钟","点击修改区域","参考黑体热图中心","提高温度测量准确性"]}
{"id":"KB-IR-SOP-0003","title":"上半身正侧位标准图可作为采集参考","content":"上半身热成像采集时，宜参照上半身正位图和侧位图的标准体位进行拍摄，以保证受检者姿势一致、解剖区域暴露充分、左右对称区域可比，从而减少因体位偏差带来的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","胸腹部","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身正侧位标准图","正位图","侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0004","title":"上半身背侧位标准图可作为采集参考","content":"上半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证背部、肩胛区及脊柱旁区域显示完整，减少因身体旋转、遮挡或姿势不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["上半身","背侧位","标准图","采集参考","体位要求","背部热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["上半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["颈肩","脊柱背部","上肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["上半身背侧位标准图","背侧位","标准体位","背部采集参考","减少判读偏差"]}
{"id":"KB-IR-SOP-0005","title":"下半身正侧位标准图可作为采集参考","content":"下半身热成像采集时，宜参照下半身正位图和侧位图的标准体位进行拍摄，以保证骨盆、髋部、下肢等解剖区域显示完整，左右对应区域具备可比性，从而减少因站姿偏斜、遮挡或体位不一致造成的判读误差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","髋部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身正侧位标准图","下半身正位图","下半身侧位图","标准体位","采集参考"]}
{"id":"KB-IR-SOP-0006","title":"下半身背侧位标准图可作为采集参考","content":"下半身背侧位热成像采集时，宜参照背侧位标准图进行体位摆放和图像采集，以保证臀部、大腿后侧、小腿后侧等区域显示完整，减少因身体旋转、遮挡或站姿不一致造成的判读偏差。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["下半身","背侧位","标准图","采集参考","体位要求","后侧热成像"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["下半身背侧位热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["骨盆","臀部","下肢","膝关节"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["下半身背侧位标准图","背侧位","后侧采集参考","标准体位","减少判读偏差"]}
{"id":"KB-IR-SOP-0007","title":"膝关节正侧位标准图可作为采集参考","content":"膝关节热成像采集时，宜参照膝关节正位图和侧位图的标准体位进行拍摄，以保证膝前区、膝外侧及周围软组织区域显示清晰，便于比较双侧膝关节温度分布和局部异常热区。","category":"sop_preparation","report_sections":["report_note","doctor_opinion","health_advice"],"tags":["膝关节","正位","侧位","标准图","采集参考","体位要求"],"source":"设备操作说明（用户补充）","source_type":"internal_sop","priority":8,"status":"active","applicable_conditions":["膝关节热成像采集时"],"contraindications":[],"patient_scope":["adult"],"body_parts":["膝关节","下肢"],"risk_levels":["low"],"evidence_level":"internal_sop","retrieval_hints":["膝关节正侧位","膝关节正位图","膝关节侧位图","标准体位","采集参考"]}
