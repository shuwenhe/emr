{"id": "KB-HT-001", "title": "热成像检查前准备要点", "content": "红外热成像检查前建议静息15-20分钟，避免剧烈运动、热水浴、外用刺激性药膏与大量饮酒。环境温度宜相对稳定，减少体表温度短时波动对判读的影响。", "category": "sop_preparation", "report_sections": ["report_note", "health_advice"], "tags": ["检查准备", "热成像", "流程"], "source": "院内热成像检查SOP v1.0", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["门诊常规热成像采集前"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": [], "evidence_level": "internal_sop", "retrieval_hints": ["检查前准备", "静息15到20分钟", "避免热刺激"]}
{"id": "KB-HT-002", "title": "体表温度判读的相对性原则", "content": "体表温度受环境、年龄、代谢和姿势影响，临床判读应重点关注左右对称差异、局部异常热点/冷点与动态变化，不宜仅凭单次绝对温度下结论。", "category": "interpretation_rule", "report_sections": ["diagnosis", "doctor_opinion", "health_advice"], "tags": ["判读原则", "温度指标", "对称性"], "source": "热成像判读规范（试行）", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["左右对称ROI可比较", "采集姿势与环境基本稳定"], "contraindications": ["近期外部热刺激或环境波动未校正时慎用单次结论"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "四肢"], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["左右对称差异", "相对温差", "不要只看绝对温度"]}
{"id": "KB-HT-003", "title": "ROI温差提示意义", "content": "当左右对应ROI温差持续大于约0.5°C时，可提示局部循环或炎症相关风险增加。建议结合主诉、触诊和必要的实验室/影像检查综合评估。", "category": "interpretation_symmetry", "report_sections": ["diagnosis", "doctor_opinion", "health_advice"], "tags": ["ROI", "左右温差", "风险提示"], "source": "区域温度对比共识（摘要）", "source_type": "consensus", "priority": 9, "status": "active", "applicable_conditions": ["存在可比较的左右对应ROI", "温差结果稳定"], "contraindications": ["单次采集质量不足时不宜直接强化解释"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节", "四肢"], "risk_levels": ["medium", "high"], "evidence_level": "consensus", "retrieval_hints": ["ROI温差大于0.5", "左右温差", "局部循环风险"], "structured_advice": {"threshold_delta_c": 0.5, "interpretation_focus": "left_right_roi_delta"}}
{"id": "KB-HT-004", "title": "高温异常区域处理建议", "content": "若局部区域温度明显高于周围组织，医生意见可提示炎症或应激可能，并建议减少局部负荷、观察48-72小时变化；若伴红肿热痛或全身不适，建议进一步就医评估。", "category": "interpretation_hotspot", "report_sections": ["doctor_opinion", "treatment_plan_text", "health_advice"], "tags": ["异常区域", "高温", "医生意见"], "source": "院内门诊随访建议单", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["存在局部热点或高温异常区域"], "contraindications": ["近期理疗、热敷、运动后短期热增高需谨慎解释"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节"], "risk_levels": ["medium", "high"], "evidence_level": "internal_sop", "retrieval_hints": ["局部高温", "异常热点", "炎症或应激"], "structured_advice": {"observe_hours_min": 48, "observe_hours_max": 72, "action": "reduce_local_load"}}
{"id": "KB-HT-005", "title": "低温异常区域处理建议", "content": "局部低温可与末梢循环下降、受压或慢性供血不足相关。治疗方案建议可包含保暖、适度活动和局部理疗评估；若出现麻木、苍白或持续疼痛，应尽快专科评估。", "category": "interpretation_coldspot", "report_sections": ["doctor_opinion", "treatment_plan_text", "health_advice"], "tags": ["异常区域", "低温", "治疗建议"], "source": "慢性疼痛管理手册（节选）", "source_type": "expert_opinion", "priority": 8, "status": "active", "applicable_conditions": ["存在局部冷点或低温异常"], "contraindications": ["寒冷环境暴露后单次结果需谨慎解释"], "patient_scope": ["adult"], "body_parts": ["四肢", "腰背"], "risk_levels": ["medium"], "evidence_level": "expert_opinion", "retrieval_hints": ["局部低温", "末梢循环下降", "冷点处理"], "structured_advice": {"action": "warm_keep_and_physical_therapy_assessment"}}
{"id": "KB-HT-006", "title": "医生意见书写模板要点", "content": "医生意见建议采用“发现-解释-建议-复评”结构：先描述热图发现，再给出谨慎解释，随后提供可执行建议，最后明确复评时间和红旗症状。应包含“仅供参考，需结合临床”提示。", "category": "doctor_opinion_rule", "report_sections": ["doctor_opinion", "report_note", "health_advice"], "tags": ["医生意见", "报告写作", "模板"], "source": "病历书写规范补充条款", "source_type": "guideline", "priority": 9, "status": "active", "applicable_conditions": ["生成医生意见或报告说明"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["发现解释建议复评", "仅供参考需结合临床", "医生意见模板"], "structured_advice": {"writing_structure": ["发现", "解释", "建议", "复评"]}}
{"id": "KB-HT-007", "title": "治疗方案建议的结构化字段", "content": "治疗建议可结构化为频次、疗程、目标区域、强度和复评节点。例如：每周2-3次，2周为一疗程，重点关注异常ROI区域，1-2周后复测热成像并调整方案。", "category": "treatment_guideline", "report_sections": ["treatment_plan_text", "health_advice"], "tags": ["治疗方案", "频次", "疗程", "复评"], "source": "康复治疗路径建议（内部版）", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["需要输出治疗建议", "无明确禁忌"], "contraindications": ["存在红旗症状或需转诊情形时不应仅给常规方案"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节"], "risk_levels": ["low", "medium"], "evidence_level": "internal_sop", "retrieval_hints": ["每周2到3次", "2周一疗程", "异常ROI复测"], "structured_advice": {"sessions_per_week": "2-3", "course_duration_weeks": 2, "follow_up_weeks": "1-2"}}
{"id": "KB-HT-008", "title": "禁忌与转诊提醒", "content": "若患者存在发热、急性外伤、活动性出血、严重感染、肿瘤治疗期或妊娠等特殊情况，报告应提示谨慎干预，必要时优先专科评估或转诊，不建议仅依赖热成像结论。", "category": "contraindication", "report_sections": ["doctor_opinion", "treatment_plan_text", "report_note", "health_advice"], "tags": ["禁忌症", "转诊", "安全"], "source": "临床安全边界清单 v2", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["存在特殊病情或红旗症状"], "contraindications": [], "patient_scope": ["adult", "female"], "body_parts": [], "risk_levels": ["high"], "evidence_level": "guideline", "retrieval_hints": ["发热外伤出血感染妊娠", "优先转诊", "谨慎干预"], "structured_advice": {"action": "refer_specialist", "urgency": "high"}}
{"id": "KB-HT-009", "title": "复评时间与疗效跟踪", "content": "建议将复评周期写入报告：轻度异常可在7-14天复评，中重度异常可在3-7天复评。复评时对比温度范围、异常区域数量和ROI温差变化，作为疗效趋势依据。", "category": "follow_up_rule", "report_sections": ["treatment_plan_text", "doctor_opinion", "report_note", "health_advice"], "tags": ["复评", "疗效跟踪", "趋势分析"], "source": "门诊随访流程规范", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["需要给出随访或复评建议"], "contraindications": ["出现快速加重症状时不应按常规复评周期处理"], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "internal_sop", "retrieval_hints": ["7到14天复评", "3到7天复评", "趋势跟踪"], "structured_advice": {"low_follow_up_days_min": 7, "low_follow_up_days_max": 14, "high_follow_up_days_min": 3, "high_follow_up_days_max": 7}}
{"id": "KB-HT-010", "title": "报告结论的风险分层表达", "content": "诊断结论建议按低/中/高风险分层输出。低风险强调生活方式调整，中风险强调短期复评与针对性干预，高风险需明确进一步检查与及时就医建议。避免使用绝对化措辞。", "category": "risk_stratification", "report_sections": ["diagnosis", "doctor_opinion", "report_note", "health_advice"], "tags": ["风险分层", "诊断结论", "报告质量"], "source": "红外热成像评估报告模板说明", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["生成最终诊断结论"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["低中高风险表达", "避免绝对化措辞", "报告风险分层"], "structured_advice": {"output_style": "risk_layered", "language_constraint": "avoid_absolute_claims"}}
{"id": "KB-IR-SOP-0001", "title": "热成像检查前静息要求", "content": "红外热成像检查前宜静息15至20分钟，避免剧烈运动、热水浴、饮酒及外用刺激性药物，以减少短时体表温度波动对判读的干扰。", "category": "sop_preparation", "report_sections": ["report_note", "health_advice"], "tags": ["检查准备", "静息", "环境控制"], "source": "院内热成像检查SOP v1.0", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["门诊常规热成像采集"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": [], "evidence_level": "internal_sop", "retrieval_hints": ["检查前准备", "静息20分钟", "避免热刺激"]}
{"id": "KB-IR-INT-0001", "title": "左右对称差异优先于绝对温度", "content": "体表温度判读应优先关注左右对称区域的相对温差、局部热点或冷点分布及动态变化，不宜仅依据单次绝对温度值直接下结论。", "category": "interpretation_symmetry", "report_sections": ["diagnosis", "doctor_opinion", "health_advice"], "tags": ["对称性", "温差", "判读原则"], "source": "热成像判读规范（试行）", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["左右对称ROI可比较", "采集姿势一致"], "contraindications": ["环境温度波动明显时慎用单次结论"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "四肢"], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["左右温差", "ROI对称", "相对温度"], "structured_advice": {"interpretation_focus": "symmetry_before_absolute_temperature"}}
{"id": "KB-IR-INT-0002", "title": "局部高温区提示炎症或应激风险", "content": "若局部区域温度明显高于周围组织或对侧对应区域，可提示炎症反应、应激负荷增加或局部循环活跃，应结合主诉、触诊及必要的实验室或影像检查综合评估。", "category": "interpretation_hotspot", "report_sections": ["diagnosis", "doctor_opinion", "health_advice"], "tags": ["热点", "高温", "炎症风险"], "source": "区域温度异常判读共识（摘要）", "source_type": "consensus", "priority": 8, "status": "active", "applicable_conditions": ["存在局部热点", "图像质量可判读"], "contraindications": ["近期外部热刺激未排除时慎解释"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节"], "risk_levels": ["medium", "high"], "evidence_level": "consensus", "retrieval_hints": ["局部热点", "温度升高", "炎症可能"]}
{"id": "KB-IR-RISK-0001", "title": "报告结论按风险等级表达", "content": "热成像报告结论宜按低、中、高风险分层表达。低风险强调生活方式调整与观察，中风险强调短期复评及针对性干预，高风险应明确建议进一步检查或及时专科就诊。", "category": "risk_stratification", "report_sections": ["diagnosis", "doctor_opinion", "report_note", "health_advice"], "tags": ["风险分层", "报告结论", "措辞规范"], "source": "红外热成像评估报告模板说明", "source_type": "guideline", "priority": 9, "status": "active", "applicable_conditions": ["生成最终报告结论"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["低中高风险", "风险分层", "结论表达"], "structured_advice": {"output_style": "risk_layered"}}
{"id": "KB-IR-TX-0001", "title": "中等风险病例建议短期复评", "content": "对于中等风险热成像异常，治疗建议宜包含减轻局部负荷、针对异常区域的理疗或灸疗评估，并建议于7至14天内复测热成像，比较ROI温差及异常区域范围变化。", "category": "follow_up_rule", "report_sections": ["treatment_plan_text", "doctor_opinion", "health_advice"], "tags": ["复评", "中风险", "治疗建议"], "source": "门诊随访流程规范", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["风险等级为medium"], "contraindications": ["出现红旗症状时不应仅安排常规复评"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背"], "risk_levels": ["medium"], "evidence_level": "internal_sop", "retrieval_hints": ["7到14天复评", "中风险复查", "趋势比较"], "structured_advice": {"follow_up_days_min": 7, "follow_up_days_max": 14, "action": "复测热成像并比较ROI变化"}}
{"id": "KB-IR-SAFE-0001", "title": "存在红旗情况时优先转诊评估", "content": "若患者存在发热、急性外伤、活动性出血、严重感染、持续剧烈疼痛、神经功能异常或肿瘤治疗期等情况，报告应提示谨慎解释热成像结果，并优先建议专科评估或转诊。", "category": "contraindication", "report_sections": ["doctor_opinion", "treatment_plan_text", "report_note", "health_advice"], "tags": ["禁忌", "转诊", "安全边界"], "source": "临床安全边界清单 v2", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["存在红旗症状或特殊病情"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["high"], "evidence_level": "guideline", "retrieval_hints": ["转诊提醒", "红旗症状", "谨慎干预"], "structured_advice": {"action": "refer_specialist", "urgency": "high"}}
{"id": "KB-IR-HA-0001", "title": "颈肩部低风险居家保健建议", "content": "对于颈肩部低风险热成像异常，建议以作息调整和轻负荷活动为主。每日进行2至3次颈肩牵伸与肩胛稳定练习，每次10至15分钟；避免久坐超过45分钟，工作间歇做短时活动。若症状持续或加重，应提前复评。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["颈肩", "低风险", "作息调整", "拉伸"], "source": "门诊居家管理建议单 v1.1", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["风险等级为low", "颈肩部存在轻度异常"], "contraindications": ["急性外伤或神经症状明显时不宜仅居家处理"], "patient_scope": ["adult"], "body_parts": ["颈肩"], "risk_levels": ["low"], "evidence_level": "internal_sop", "retrieval_hints": ["颈肩拉伸", "每45分钟活动", "低风险居家管理"], "structured_advice": {"action": "stretch_and_posture_breaks", "sessions_per_day": "2-3", "duration_minutes": "10-15", "follow_up_days_min": 7, "follow_up_days_max": 14}}
{"id": "KB-IR-HA-0002", "title": "腰背部低风险活动与保暖建议", "content": "腰背部低风险异常可优先采用保暖与节律性活动。建议避免久坐久站，采用分段活动策略；每日快走20至30分钟，配合核心稳定训练。夜间注意腰背保暖，避免受凉后症状波动。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["腰背", "低风险", "保暖", "快走"], "source": "慢性疼痛门诊健康教育手册", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["风险等级为low", "腰背部温度异常轻度"], "contraindications": ["伴进行性下肢无力或大小便异常时需尽快就医"], "patient_scope": ["adult"], "body_parts": ["腰背"], "risk_levels": ["low"], "evidence_level": "internal_sop", "retrieval_hints": ["腰背保暖", "快走20到30分钟", "核心稳定"], "structured_advice": {"action": "warm_keep_and_walk", "walk_minutes": "20-30", "follow_up_days_min": 7, "follow_up_days_max": 14}}
{"id": "KB-IR-HA-0003", "title": "中风险病例短期复评计划", "content": "中风险热成像异常建议在7至14天内进行一次复评，重点比较异常区域范围、左右ROI温差和主诉变化。居家期间建议记录每日疼痛评分、活动耐受和睡眠质量，作为复评决策依据。", "category": "follow_up_rule", "report_sections": ["health_advice", "treatment_plan_text", "doctor_opinion"], "tags": ["中风险", "复评", "趋势跟踪"], "source": "门诊随访流程规范", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["风险等级为medium"], "contraindications": ["出现红旗症状时不应等待常规复评"], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["medium"], "evidence_level": "guideline", "retrieval_hints": ["7到14天复评", "记录疼痛评分", "趋势对比"], "structured_advice": {"action": "scheduled_recheck", "follow_up_days_min": 7, "follow_up_days_max": 14, "tracking_items": ["pain_score", "activity_tolerance", "sleep_quality"]}}
{"id": "KB-IR-HA-0004", "title": "高风险病例就医与监测建议", "content": "高风险热成像异常不建议仅依赖居家观察。应尽快安排专科评估，并在等待就医期间减少高负荷活动，记录症状变化和诱发因素。若出现夜间痛醒、进行性加重或神经症状，应立即就医。", "category": "contraindication", "report_sections": ["health_advice", "doctor_opinion", "report_note"], "tags": ["高风险", "及时就医", "监测"], "source": "临床安全边界清单 v2", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["风险等级为high"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["high"], "evidence_level": "guideline", "retrieval_hints": ["高风险尽快就医", "夜间痛醒", "神经症状"], "structured_advice": {"action": "urgent_specialist_assessment", "urgency": "high", "self_monitoring": "symptom_diary_until_visit"}}
{"id": "KB-IR-HA-0005", "title": "四肢冷点的保暖与循环管理", "content": "四肢低温异常可先行末梢循环管理。建议保持肢端温暖，避免长时间静止体位，每60分钟进行3至5分钟踝泵或握拳伸指活动；可进行温和热敷，但避免高温烫伤。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["四肢", "冷点", "循环管理", "热敷"], "source": "慢性疼痛管理手册（节选）", "source_type": "expert_opinion", "priority": 8, "status": "active", "applicable_conditions": ["四肢存在低温异常", "无急性血管事件表现"], "contraindications": ["明显肿胀变色或剧烈疼痛时应尽快评估"], "patient_scope": ["adult"], "body_parts": ["四肢"], "risk_levels": ["medium"], "evidence_level": "expert_opinion", "retrieval_hints": ["四肢保暖", "每60分钟活动", "末梢循环"], "structured_advice": {"action": "peripheral_circulation_support", "break_interval_minutes": 60, "micro_activity_minutes": "3-5"}}
{"id": "KB-IR-HA-0006", "title": "热点区域负荷管理建议", "content": "局部热点区域建议短期内减少重复负荷和高强度动作，采用分次活动方式并观察48至72小时变化。活动后若红肿热痛明显加重，应停止高负荷训练并及时就医。", "category": "treatment_guideline", "report_sections": ["health_advice", "doctor_opinion", "treatment_plan_text"], "tags": ["热点", "负荷管理", "48到72小时观察"], "source": "院内门诊随访建议单", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["存在局部热点或高温异常"], "contraindications": ["伴发热或全身不适时不宜仅观察"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节"], "risk_levels": ["medium", "high"], "evidence_level": "internal_sop", "retrieval_hints": ["减少局部负荷", "48到72小时观察", "红肿热痛加重"], "structured_advice": {"action": "load_reduction_and_observe", "observe_hours_min": 48, "observe_hours_max": 72}}
{"id": "KB-IR-HA-0007", "title": "膝关节异常的运动分级建议", "content": "膝关节异常建议采用低冲击活动优先原则。可选择平地步行、固定单车或水中运动，避免跳跃和急停急转。每周3至5次，每次20至30分钟，并根据疼痛和次日反应调整强度。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["膝关节", "低冲击运动", "强度分级"], "source": "康复运动处方建议（内部版）", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["膝关节存在温度异常", "无急性创伤红旗"], "contraindications": ["关节明显肿胀发热或负重困难时需先评估"], "patient_scope": ["adult"], "body_parts": ["膝关节"], "risk_levels": ["low", "medium"], "evidence_level": "internal_sop", "retrieval_hints": ["低冲击运动", "每周3到5次", "20到30分钟"], "structured_advice": {"action": "graded_low_impact_exercise", "sessions_per_week": "3-5", "duration_minutes": "20-30"}}
{"id": "KB-IR-HA-0008", "title": "睡眠与疼痛共管建议", "content": "睡眠不足会放大疼痛感受并影响恢复。建议固定入睡和起床时间，睡前1小时减少电子屏幕刺激，必要时进行呼吸放松训练。若连续1周睡眠质量差且症状加重，建议提前复评。", "category": "follow_up_rule", "report_sections": ["health_advice", "report_note"], "tags": ["睡眠管理", "疼痛共管", "复评"], "source": "门诊健康教育手册", "source_type": "guideline", "priority": 8, "status": "active", "applicable_conditions": ["存在慢性疼痛主诉", "恢复期管理"], "contraindications": ["严重失眠伴情绪症状需多学科评估"], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium"], "evidence_level": "guideline", "retrieval_hints": ["固定作息", "睡前放松", "连续1周睡眠差"], "structured_advice": {"action": "sleep_hygiene_and_relaxation", "review_trigger_days": 7}}
{"id": "KB-IR-HA-0009", "title": "办公人群姿势与间歇活动建议", "content": "长期伏案人群建议采用45至60分钟工作、5分钟活动的节律，调整屏幕高度与坐姿支撑，避免持续耸肩或含胸。每日安排2次肩颈和胸椎活动训练，可降低姿势负荷相关症状。", "category": "treatment_guideline", "report_sections": ["health_advice"], "tags": ["办公人群", "姿势管理", "间歇活动"], "source": "职业相关肌骨健康建议", "source_type": "consensus", "priority": 8, "status": "active", "applicable_conditions": ["久坐久站职业暴露", "颈肩或胸背不适"], "contraindications": [], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背"], "risk_levels": ["low", "medium"], "evidence_level": "consensus", "retrieval_hints": ["45到60分钟间歇", "屏幕高度", "肩颈活动"], "structured_advice": {"action": "ergonomic_breaks", "work_block_minutes": "45-60", "break_minutes": 5}}
{"id": "KB-IR-HA-0010", "title": "体重与活动负荷联动建议", "content": "对腰背或膝关节反复异常者，建议将体重管理纳入保健计划。通过饮食结构优化与规律活动逐步降低负荷，可改善长期症状波动。建议每周记录体重和活动量，关注趋势而非单次变化。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["体重管理", "负荷控制", "趋势记录"], "source": "慢性疼痛综合管理路径", "source_type": "guideline", "priority": 7, "status": "active", "applicable_conditions": ["腰背或膝关节反复异常"], "contraindications": ["短期极端减重方案不推荐"], "patient_scope": ["adult"], "body_parts": ["腰背", "膝关节"], "risk_levels": ["low", "medium"], "evidence_level": "guideline", "retrieval_hints": ["体重管理", "活动负荷", "每周趋势"], "structured_advice": {"action": "weight_and_load_management", "tracking_items": ["weekly_weight", "weekly_activity"]}}
{"id": "KB-IR-HA-0011", "title": "饮食与水分管理建议", "content": "恢复期建议保证规律饮食与充足饮水，避免长期高糖高脂饮食及过量酒精摄入。可优先选择高质量蛋白、蔬果和全谷物，支持组织修复与代谢稳定。", "category": "treatment_guideline", "report_sections": ["health_advice", "report_note"], "tags": ["饮食", "补水", "恢复期"], "source": "门诊营养与康复建议", "source_type": "guideline", "priority": 7, "status": "active", "applicable_conditions": ["慢性疼痛或亚健康管理"], "contraindications": ["合并特殊代谢疾病者需个体化营养方案"], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium"], "evidence_level": "guideline", "retrieval_hints": ["规律饮食", "减少酒精", "高质量蛋白"], "structured_advice": {"action": "nutrition_and_hydration_optimization"}}
{"id": "KB-IR-HA-0012", "title": "复测前一致性条件建议", "content": "为保证复测可比性，建议在相近时间段、相近环境温度和相似活动状态下进行热成像复测。检查前应维持与首次检查一致的静息准备流程，减少外界因素干扰。", "category": "sop_preparation", "report_sections": ["health_advice", "report_note"], "tags": ["复测一致性", "环境控制", "静息准备"], "source": "热成像复测流程建议", "source_type": "internal_sop", "priority": 9, "status": "active", "applicable_conditions": ["计划进行热成像复评"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "internal_sop", "retrieval_hints": ["同时间段复测", "相似环境温度", "复测前准备一致"], "structured_advice": {"action": "retest_under_consistent_conditions"}}
{"id": "KB-IR-HA-0013", "title": "高风险等待就医期间自我保护建议", "content": "在已安排专科就医但尚未就诊期间，建议避免高强度训练、重体力劳动和可能诱发症状加重的动作，优先保证休息和症状监测。若出现快速恶化，应立即急诊评估。", "category": "contraindication", "report_sections": ["health_advice", "doctor_opinion"], "tags": ["高风险", "等待就医", "自我保护"], "source": "临床安全边界清单 v2", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["风险等级为high", "已建议转诊"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["high"], "evidence_level": "guideline", "retrieval_hints": ["避免高强度活动", "症状快速恶化", "急诊评估"], "structured_advice": {"action": "protective_rest_until_specialist_visit", "urgency": "high"}}
{"id": "KB-IR-HA-0014", "title": "晨僵与活动耐受监测建议", "content": "若存在晨僵或活动耐受下降，建议每日固定时段记录晨僵持续时间、步行耐受和疼痛评分变化。连续3至5天恶化可作为提前复评信号，避免延迟干预。", "category": "follow_up_rule", "report_sections": ["health_advice", "doctor_opinion"], "tags": ["晨僵", "活动耐受", "提前复评"], "source": "门诊随访流程规范", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["有晨僵或活动受限主诉"], "contraindications": [], "patient_scope": ["adult"], "body_parts": ["腰背", "膝关节", "四肢"], "risk_levels": ["medium", "high"], "evidence_level": "internal_sop", "retrieval_hints": ["晨僵持续时间", "3到5天恶化", "提前复评"], "structured_advice": {"action": "daily_function_tracking", "deterioration_window_days": "3-5"}}
{"id": "KB-IR-HA-0015", "title": "颈肩部夜间症状管理建议", "content": "颈肩部夜间不适者建议优化枕高与睡姿，避免长时间单侧卧位和上肢过度外展。睡前可进行温和牵伸与呼吸放松，减少夜间痛醒频率。若夜间症状进行性加重，应尽快复评。", "category": "treatment_guideline", "report_sections": ["health_advice"], "tags": ["颈肩", "夜间痛醒", "睡姿调整"], "source": "门诊康复护理建议", "source_type": "expert_opinion", "priority": 7, "status": "active", "applicable_conditions": ["颈肩部夜间不适"], "contraindications": ["合并明显神经压迫表现时需先专科评估"], "patient_scope": ["adult"], "body_parts": ["颈肩"], "risk_levels": ["low", "medium"], "evidence_level": "expert_opinion", "retrieval_hints": ["枕高调整", "睡姿优化", "夜间痛醒管理"], "structured_advice": {"action": "sleep_posture_optimization"}}
{"id": "KB-IR-HA-0016", "title": "腰背部搬举动作保护建议", "content": "腰背部异常期间应避免突然扭转和弯腰提重物。确需搬举时建议采用屈髋屈膝、贴近身体和分次搬运原则，减少瞬时负荷。活动后若症状明显上升，建议缩减负荷并复评。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["腰背", "搬举保护", "负荷控制"], "source": "职业相关肌骨保护建议", "source_type": "consensus", "priority": 8, "status": "active", "applicable_conditions": ["腰背部存在异常或疼痛"], "contraindications": ["急性外伤后不建议自行负重活动"], "patient_scope": ["adult"], "body_parts": ["腰背"], "risk_levels": ["low", "medium"], "evidence_level": "consensus", "retrieval_hints": ["屈髋屈膝搬举", "避免突然扭转", "分次搬运"], "structured_advice": {"action": "safe_lifting_mechanics"}}
{"id": "KB-IR-HA-0017", "title": "四肢麻木或无力出现时处置建议", "content": "若在保健管理期间出现新发麻木、无力、步态异常或精细动作下降，不建议继续仅居家观察，应尽快完成神经系统相关评估，必要时急诊处理。", "category": "contraindication", "report_sections": ["health_advice", "doctor_opinion", "report_note"], "tags": ["麻木", "无力", "神经症状", "转诊"], "source": "临床安全边界清单 v2", "source_type": "guideline", "priority": 10, "status": "active", "applicable_conditions": ["出现神经功能异常征象"], "contraindications": [], "patient_scope": ["adult"], "body_parts": ["四肢"], "risk_levels": ["high"], "evidence_level": "guideline", "retrieval_hints": ["新发麻木无力", "步态异常", "尽快神经评估"], "structured_advice": {"action": "urgent_neurologic_evaluation", "urgency": "high"}}
{"id": "KB-IR-HA-0018", "title": "中风险运动恢复分阶段建议", "content": "中风险人群建议分阶段恢复活动：第1阶段以低强度有氧和活动度训练为主，第2阶段逐步加入抗阻训练。每阶段至少维持5至7天，并依据症状与次日恢复情况调整进度。", "category": "treatment_guideline", "report_sections": ["health_advice", "treatment_plan_text"], "tags": ["中风险", "分阶段恢复", "抗阻训练"], "source": "康复治疗路径建议（内部版）", "source_type": "internal_sop", "priority": 8, "status": "active", "applicable_conditions": ["风险等级为medium", "无红旗症状"], "contraindications": ["活动后症状明显恶化时应暂停升级训练"], "patient_scope": ["adult"], "body_parts": ["颈肩", "腰背", "膝关节", "四肢"], "risk_levels": ["medium"], "evidence_level": "internal_sop", "retrieval_hints": ["分阶段恢复", "5到7天一阶段", "活动后次日评估"], "structured_advice": {"action": "staged_activity_progression", "stage_days_min": 5, "stage_days_max": 7}}
{"id": "KB-IR-HA-0019", "title": "低风险异常的自我管理边界", "content": "低风险异常以生活方式干预和短期观察为主，但若出现持续加重、功能受限扩大或影响日常生活，应从低风险路径转入复评路径，不建议长期拖延。", "category": "follow_up_rule", "report_sections": ["health_advice", "doctor_opinion", "report_note"], "tags": ["低风险", "观察边界", "转入复评"], "source": "红外热成像评估报告模板说明", "source_type": "guideline", "priority": 9, "status": "active", "applicable_conditions": ["风险等级为low"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low"], "evidence_level": "guideline", "retrieval_hints": ["低风险观察边界", "功能受限扩大", "转入复评"], "structured_advice": {"action": "watchful_waiting_with_escalation", "escalation_trigger": "worsening_or_functional_decline"}}
{"id": "KB-IR-HA-0020", "title": "保健建议结尾规范用语", "content": "保健建议末尾应强调“以上建议仅供参考，需结合临床评估与个体情况执行”，并提示出现红旗症状时及时就医，以避免患者将热成像结果作为唯一决策依据。", "category": "doctor_opinion_rule", "report_sections": ["health_advice", "report_note"], "tags": ["规范用语", "仅供参考", "就医提醒"], "source": "病历书写规范补充条款", "source_type": "guideline", "priority": 9, "status": "active", "applicable_conditions": ["输出保健建议或报告说明"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["仅供参考", "结合临床评估", "红旗症状及时就医"], "structured_advice": {"action": "append_safety_disclaimer", "language_constraint": "must_include_reference_only_clause"}}
{"id": "KB-IR-HA-0020", "title": "保健建议结尾规范用语", "content": "保健建议末尾应强调“以上建议仅供参考，需结合临床评估与个体情况执行”，并提示出现红旗症状时及时就医，以避免患者将热成像结果作为唯一决策依据。", "category": "doctor_opinion_rule", "report_sections": ["health_advice", "report_note"], "tags": ["规范用语", "仅供参考", "就医提醒"], "source": "病历书写规范补充条款", "source_type": "guideline", "priority": 9, "status": "active", "applicable_conditions": ["输出保健建议或报告说明"], "contraindications": [], "patient_scope": ["adult"], "body_parts": [], "risk_levels": ["low", "medium", "high"], "evidence_level": "guideline", "retrieval_hints": ["仅供参考", "结合临床评估", "红旗症状及时就医"], "structured_advice": {"action": "append_safety_disclaimer", "language_constraint": "must_include_reference_only_clause"}}
