[Unit]
Description=EMR Auto Git Push Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash __PROJECT_ROOT__/scripts/auto_git_push_daemon.sh
Restart=always
RestartSec=5

StandardOutput=append:__PROJECT_ROOT__/logs/__SERVICE_NAME__.out.log
StandardError=append:__PROJECT_ROOT__/logs/__SERVICE_NAME__.err.log

[Install]
WantedBy=default.target
