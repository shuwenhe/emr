{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web Dev Hot Reload",
      "type": "shell",
      "command": "make",
      "args": [
        "web-dev-start"
      ],
      "options": {
        "cwd": "/app/emr"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": [
        {
          "owner": "web-dev",
          "pattern": {
            "regexp": "^(?!x)x$",
            "message": 0
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "\\[web-dev\\] started",
            "endsPattern": "\\[web-dev\\] started"
          }
        }
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "KB Auto Sync Watch",
      "type": "shell",
      "command": "/home/shuwen/venv/bin/python",
      "args": [
        "/home/shuwen/emr/rag/kb/sync_jsonl_to_json.py",
        "--watch",
        "--prefer",
        "newer"
      ],
      "options": {
        "cwd": "/home/shuwen/emr/rag/kb"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": [
        {
          "owner": "kb-sync",
          "pattern": {
            "regexp": "^(?!x)x$",
            "message": 0
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "开始监听：",
            "endsPattern": "开始监听："
          }
        }
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}