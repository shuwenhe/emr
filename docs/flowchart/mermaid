flowchart TD

    %% ========== S1 ==========
    subgraph S1["S1 患者端"]
        A[患者问诊]
        B[红外热成像设备<br/>采集红外图像]
        A --> B
    end

    %% ========== S2 ==========
    subgraph S2["S2 云端分析平台（8块完整版）"]
        C[1 数据接入与设备管理层<br/>设备绑定/上传接口/状态监测]
        D[2 数据存储与资源管理层<br/>原始数据/图像/元数据/版本管理]
        E[3 预处理与质量控制（QC）<br/>去噪校正/配准对齐/ROI定位/质量评估]
        F[4 热层析重建模块（热传导反演）<br/>时序建模/反问题求解/深层热源参数]
        G[5 AI推理与特征计算层<br/>分割检测/分类回归/置信度输出]
        H[6 多源融合与评估规则引擎<br/>问诊+影像+治疗记录融合/分级判定]
        I[7 灸疗方案生成与参数推荐<br/>穴位区域/温度距离/时长次数/禁忌约束]
        J[8 报告生成与结果分发<br/>评估报告输出/方案下发/数据回写]

        C --> D --> E --> F --> G --> H --> I --> J
    end

    %% ========== S3 ==========
    subgraph S3["S3 治疗反馈与实施"]
        K[艾灸师询问患者情况]
        L[适当调整灸疗方案]
        M[智能艾灸仪实施艾灸]
        K --> L --> M
    end

    %% ========== S4 ==========
    subgraph S4["S4 疗效评估"]
        N[施灸前后效果对比]
        O[诊疗结束]
        N --> O
    end

    %% ========== Cross-stage links ==========
    B --> C
    J --> K
    M --> N
