flowchart TD

    %% ========= S1 =========
    subgraph S1["S1 患者端"]
        A[患者问诊]
        B[红外热成像设备<br/>采集红外图像]
        A --> B
    end

    %% ========= S2 =========
    subgraph S2["S2 云端分析平台（含报告与层析算法）"]

        C[1 数据接入与设备管理层]
        D[2 数据存储与资源管理层]
        E[3 预处理与质量控制 QC]

        %% ===== 4 热层析重建模块 + 子算法流程 =====
        subgraph F["4 热层析重建模块（热层析/热传导反演）"]
            F0[输入：时序红外温度场/采集参数/环境参数]
            F1[时序分段与配准<br/>升温期/稳态/冷却期对齐]
            F2[辐射-温度校正与边界条件设定<br/>发射率/环境补偿/对流辐射边界]
            F3[前向热传导模型构建<br/>组织热传导方程/离散化]
            F4[反问题定义<br/>目标：解释表面温度变化→推断深层热源/参数]
            F5[正则化与先验约束<br/>平滑/稀疏/生理可行性/解剖区域约束]
            F6[迭代求解与收敛判据<br/>梯度/变分/迭代更新/停止条件]
            F7[输出：层析热图与层析指标<br/>深层热源分布/深度相关参数/置信度]

            F0 --> F1 --> F2 --> F3 --> F4 --> F5 --> F6 --> F7
        end

        G[5 AI推理与特征计算层]
        H[6 多源融合与评估规则引擎]

        %% ===== 报告数据处理子流程 =====
        subgraph R["报告数据处理与生成过程"]
            R1[指标计算与统计分析<br/>Max/Min/Avg/面积/对称性]
            R2[异常区域识别与标注<br/>高低温区/部位映射]
            R3[风险分级与健康评估计算]
            R4[图像组装<br/>实时热像/代谢异常热图/层析热图/参考热图]
            R5[结构化语义生成<br/>热源描述/评估提示/保健建议]
            R6[报告模板渲染与输出<br/>PDF/WEB/版本固化]
            R1 --> R2 --> R3 --> R4 --> R5 --> R6
        end

        I[7 灸疗方案生成与参数推荐]
        J[8 报告发布与结果分发]

        C --> D --> E --> F --> G --> H
        F7 --> R1
        H --> R1
        R6 --> I --> J
    end

    %% ========= S3 =========
    subgraph S3["S3 治疗反馈与实施"]
        K[艾灸师询问患者情况]
        L[适当调整灸疗方案]
        M[智能艾灸仪实施艾灸]
        K --> L --> M
    end

    %% ========= S4 =========
    subgraph S4["S4 疗效评估"]
        N[施灸前后效果对比<br/>层析热图/指标对齐]
        O[诊疗结束]
        N --> O
    end

    %% ========= Cross =========
    B --> C
    J --> K
    M --> N
